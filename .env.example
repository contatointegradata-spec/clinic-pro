# Database
POSTGRES_USER=clinicuser
POSTGRES_PASSWORD=clinicpass_CHANGE_ME
POSTGRES_DB=clinicmedia

# JWT
JWT_SECRET=your-super-secret-jwt-key-CHANGE-ME-in-production

# NFS-e (Emissor Nacional): chave AES-256 que cifra os certificados A1 em repouso.
# 32 bytes em hex (gere com: openssl rand -hex 32). Se ausente, é derivada do
# JWT_SECRET — trocar qualquer uma das duas exige que os médicos reenviem o .pfx.
NFSE_ENCRYPTION_KEY=
# Preço por nota autorizada em produção, em centavos (padrão 20 = R$ 0,20)
NFSE_UNIT_PRICE_CENTS=20
# Access token de vida curta — o refresh token (revogável, ver tabela
# RefreshToken) é quem mantém a sessão viva por mais tempo.
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Server
VPS_IP=2.25.185.223
NODE_ENV=production

BACKEND_URL=https://cliniqpro.integradata.app.br
FRONTEND_URL=https://cliniqpro.integradata.app.br
# URL pública (HTTPS) usada nos links externos, ex.: endpoint do webhook da Kiwify
PUBLIC_APP_URL=https://cliniqpro.integradata.app.br

# Domínio (preencher quando o domínio for comprado e apontado para a VPS —
# ver docs/ativar-https.md). Enquanto estiver vazio, o sistema continua
# servindo normalmente por HTTP no IP, sem nenhuma mudança de comportamento.
DOMAIN=
LETSENCRYPT_EMAIL=

# Backup do Postgres (ver docs/backup-restore.md)
BACKUP_RETENTION_DAYS=14

# Agente de IA — reativação de paciente inativo (dias sem consulta concluída
# até disparar o follow-up; precisa de um LightIntegrationConfig+template
# ativo pro evento PATIENT_INACTIVE_FOLLOWUP pra efetivamente enviar algo)
PATIENT_INACTIVE_FOLLOWUP_DAYS=180

# Agente de IA — motor Gemini (preencher no painel da conta — nunca
# commitar valores reais). Preferível: configure pelo menu Admin >
# Integrações no próprio app — o valor salvo no banco tem prioridade sobre
# estas env vars, que ficam só como fallback/compatibilidade pra quem
# prefere configurar por redeploy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# WhatsApp Configuration
WA_SEND_GRACE_PERIOD_MS=15000
WA_RETRY_MESSAGE_TTL_DAYS=7

# Versionamento de build (preenchidos automaticamente pelo deploy.sh a partir do git;
# não é necessário setar manualmente em produção)
RELEASE_SHA=development
BUILD_DATE=

# Assinatura Clinic Pro (plano único, ver docs/assinatura-kiwify.md)
BILLING_PROVIDER=kiwify
CLINIC_PRO_MONTHLY_PRICE_CENTS=4990
CLINIC_PRO_CURRENCY=BRL
CLINIC_PRO_TRIAL_DAYS=3
CLINIC_PRO_GRACE_PERIOD_DAYS=2

# Feature flags de rollout — deixe ENFORCEMENT em false até configurar a Kiwify de verdade
SUBSCRIPTION_FEATURE_ENABLED=true
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
KIWIFY_WEBHOOK_ENABLED=true

# Kiwify (preencher no painel da conta — nunca commitar valores reais).
# Preferível: configure pelo menu Admin > Integrações no próprio app — o valor
# salvo no banco tem prioridade sobre estas env vars, que ficam só como
# fallback/compatibilidade para quem prefere configurar por redeploy.
KIWIFY_CHECKOUT_URL=
KIWIFY_PRODUCT_ID=
KIWIFY_ACCOUNT_ID=
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
KIWIFY_WEBHOOK_SECRET=
KIWIFY_API_BASE_URL=


